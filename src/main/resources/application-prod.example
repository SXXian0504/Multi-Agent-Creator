# ========================================
# 生产环境配置（Docker 部署使用）
# ========================================

server:
  port: 8123

spring:
  servlet:
    multipart:
      max-file-size: ${SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE:50MB}
      max-request-size: ${SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE:60MB}
  # MySQL 数据库配置（通过环境变量覆盖）
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/multi_agent_creator?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8}
    username: ${SPRING_DATASOURCE_USERNAME:root}
    password: ${SPRING_DATASOURCE_PASSWORD:123456}
  # Redis 配置（通过环境变量覆盖）
  data:
    redis:
      host: ${SPRING_DATA_REDIS_HOST:localhost}
      port: ${SPRING_DATA_REDIS_PORT:6379}
      database: 0
      password: ${SPRING_DATA_REDIS_PASSWORD:}
  # AI 配置
  ai:
    dashscope:
      api-key: ${DASHSCOPE_API_KEY:xxx}

rag:
  datasource:
    url: ${RAG_DATASOURCE_URL:jdbc:postgresql://localhost:5432/multi_agent_rag}
    username: ${RAG_DATASOURCE_USERNAME:postgres}
    password: ${RAG_DATASOURCE_PASSWORD:postgres}

# Pexels API 配置
pexels:
  api-key: ${PEXELS_API_KEY:xxx}

china-image-search:
  search-url: https://cn.bing.com/images/async
  suffix: 官方 海报 剧照 角色图
  timeout: 10000
  max-candidates: 8

# 百炼文生图配置（默认万相 wanx-v1）
qwen:
  image:
    api-key: ${DASHSCOPE_API_KEY:xxx}
    model: wanx-v1
    submit-endpoint: https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
    task-endpoint: https://dashscope.aliyuncs.com/api/v1/tasks
    width: 1024
    height: 1024
    n: 1
    style: "<auto>"
    poll-interval: 5000
    max-poll-attempts: 24

# Nano Banana API 配置（可选）
nano:
  banana:
    api-key: ${NANO_BANANA_API_KEY:xxx}

## Stripe 支付配置（可选）
# Graphviz DOT 图表生成配置
graphviz:
  cli-command: ${GRAPHVIZ_CLI_COMMAND:dot}
  output-format: svg
  background-color: transparent
  timeout: 30000

# Stripe
#stripe:
#  api-key: ${STRIPE_API_KEY:}
#  webhook-secret: ${STRIPE_WEBHOOK_SECRET:}
#  success-url: ${STRIPE_SUCCESS_URL:http://localhost/vip?success=true}
#  cancel-url: ${STRIPE_CANCEL_URL:http://localhost/vip?cancelled=true}
#
# 腾讯云 COS 配置（可选）
tencent:
  cos:
    secret-id: ${TENCENT_COS_SECRET_ID:xxx}
    secret-key: ${TENCENT_COS_SECRET_KEY:xxx}
    region: ${TENCENT_COS_REGION:ap-guangzhou}
    bucket: ${TENCENT_COS_BUCKET:xxx}
